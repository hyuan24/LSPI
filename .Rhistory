# BLS
gd_bls <- function(X, y, eta_init = 1.0, epsilon = 0.25, tau = 0.5,
max_iter = 5000, tol = 1e-5) {
beta <- matrix(0, nrow = ncol(X), ncol = 1)
beta_prev <-beta
f_hist <- numeric()
log <- numeric(0)
for (k in 1:max_iter) {
current_f <- f_lr(beta, X, y)
f_hist[k] <- current_f
xi_k <- (k-1)/(k+2)
y_k <- beta + xi_k*(beta-beta_prev)
dir <- grad_f_lr(y_k, X, y)
# To do:  Convergence Criterion:
if (norm(dir, type="2")<tol) {
cat("BLS w/ Nesterov converged in", k, "iterations.\n")
break
}
# ToDO: Armijo Condition
eta <- eta_init
while (armijo3(f_lr, current_f, beta, X, eta, g, y, epsilon, dir)) {
eta <- tau * eta
}
beta_prev <- beta
beta <- y_k - eta * dir
}
if (k == max_iter) cat("BLS reached max iterations.\n")
# Graph
plot(f_hist,type="l", xlab="Iteration", ylab="f(x) (loss)", main=paste("Backtracked GD w/ Nesterov"), cex.main=0.7, cex.lab = 0.5, cex.axis=0.5)
return(list(beta = beta, f_hist = f_hist))
}
