# Nesterov's Accelerated Gradient
# Constant step size
gd_constant_nesterov <- function(X, y, eta, max_iter = 5000, tol = 1e-5) {
#cat(class(X), class(y))
beta <- matrix(0, nrow = ncol(X), ncol = 1)
#cat(class(beta))
f_hist <- numeric()
beta_prev <- beta
for (k in 1:max_iter) {
f_hist[k] <- f_lr(beta, X, y)
#g <- grad_f_lr(beta, X, y)
eta_k <- (k-1)/(k+2) # Since the objective is squared error
y_k <- beta + eta_k * (beta-beta_prev)
g <- g(y_k)
# To do: Convergence Criterion:
if (norm(g, type="2")<tol) {
cat("Constant GD w/ Nesterov converged in", k, "iterations.\n")
break
}
beta_prev <- beta
beta <- y_k- eta * g
}
if (k == max_iter) cat("Constant GD reached max iterations.\n")
# Graph
plot(f_hist,type="l", xlab="Iteration", ylab="f(x) (loss)", main=paste("Constant step-size GD w/ Nesterov"), cex.main=0.7, cex.lab = 0.5, cex.axis=0.5)
return(list(beta = beta, f_hist = f_hist))
}
# Execution
eta_chosen <- 1 # found via manual line search
res_const_polyak1 <- gd_constant_nesterov(X1, y1, eta = eta_chosen)
