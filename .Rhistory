if (norm(g, type="2")<tol) {
cat("BLS with Polyak's heavy ball converged in", k, "iterations.\n")
break
}
# ToDO: Armijo Condition
eta <- eta_init
while (armijo3(f_lr, current_f, beta, X, eta, g, y, epsilon, v)) {
eta <- tau * eta
}
beta <- beta - eta * v
}
if (k == max_iter) cat("BLS reached max iterations.\n")
# Graph
plot(log,type="l", xlab="Iteration", ylab="f(x) (loss)", main=paste("Backtracked GD with Polyak"), cex.main=0.7, cex.lab = 0.5, cex.axis=0.5)
return(list(beta = beta, f_hist = f_hist))
}
