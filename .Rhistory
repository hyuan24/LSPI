knitr::opts_chunk$set(echo = TRUE)
library(dplyr)
library(ggplot2)
# Fixed step size with x0=2
grad <- function(x) {
return (4*x^3 + 4*x)
}
fx <- function(x) {
return (x^4 + 2*x^2 + 1)
}
fixed_gd <- function(tol, x0, alpha) {
error <- Inf
x <- x0
log <- numeric(0)
while (error > tol) {
log <- c(log, fx(x))
x1 <- x - alpha * grad(x)
error <- abs(x1-x)
x <- x1
}
plot(log,type="l", xlab="Iteration", ylab="f(x)", main=paste("Fixed step size, x0 =", x0), cex.main=0.7, cex.lab = 0.5, cex.axis=0.5)
cat("f(x_min) = ", fx(x), "at x_min = ", x, "\n")
return(x)
}
fixed_gd(1e-5, 2, 1/25)
# Fixed step size with x0=5
fixed_gd(1e-5, 5, 1/75)
# Backtracking line search with x0=2
armijo <- function(x, alpha, eps) {
left <- fx(x - alpha*grad(x))
right <- fx(x) - eps * alpha * grad(x)^2
return (left > right)
}
backtrack_gd <- function(alpha0, eps, tau, tol, x0) {
log <- numeric(0)
alphalog <- numeric(0)
error <- Inf
x <- x0
while (error>tol) {
log <- c(log, fx(x))
alpha <- alpha0
while (armijo(x, alpha, eps)) {
alpha <- tau * alpha
}
alphalog <- c(alphalog, alpha)
x1 <- x - alpha * grad(x)
error <- abs(x1-x)
x <- x1
}
plot(log,type="l", xlab="Iteration", ylab="f(x)", main=paste("Backtracked GD, x0 =", x0), cex.main=0.7, cex.lab = 0.5, cex.axis=0.5)
plot(alphalog,type="l", xlab="Iteration", ylab="Step Size", main=paste("Backtracked GD, x0 =", x0), cex.main=0.7, cex.lab = 0.5, cex.axis=0.5)
cat("f(x_min) = ", fx(x), "at x_min = ", x, "\n")
return(x)
}
backtrack_gd(1/15, 0.25, 0.5, 1e-5, 2)
# Backtracking line search with x0=5
backtrack_gd(1/9, 0.25, 0.5, 1e-5, 5)
# Read datasets
df1 <- read.csv("dataset_1.csv")
df2 <- read.csv("dataset_2.csv")
y1 <- df1[,81] |> matrix()
y2 <- df2[,81] |> matrix()
X1 <- df1[,-81] |> as.matrix()
X2 <- df2[,-81] |> as.matrix()
m <- nrow(X1)
# Loss
f_lr <- function(beta, X, y) {
err <- y - X %*% beta
return((1 / (2 * nrow(X))) * sum(err^2))
}
# Gradient: grad = -(1/m) * X^T * (y - X*beta)
grad_f_lr <- function(beta, X, y) {
err <- y - X %*% beta
return(-(1 / nrow(X)) * t(X) %*% err)
}
# Algorithms
# Constant Step Size
gd_constant <- function(X, y, eta, max_iter = 5000, tol = 1e-5) {
#cat(class(X), class(y))
beta <- matrix(0, nrow = ncol(X), ncol = 1)
#cat(class(beta))
f_hist <- numeric()
log <- numeric(0)
for (k in 1:max_iter) {
f_hist[k] <- f_lr(beta, X, y)
g <- grad_f_lr(beta, X, y)
log <- c(log, f_hist[k])
# To do: Convergence Criterion:
if (norm(g, type="2")<tol) {
cat("Constant GD Converged in", k, "iterations.\n")
break
}
beta <- beta - eta * g
}
if (k == max_iter) cat("Constant GD reached max iterations.\n")
# Graph
plot(log,type="l", xlab="Iteration", ylab="f(x) (loss)", main=paste("Constant step-size GD"), cex.main=0.7, cex.lab = 0.5, cex.axis=0.5)
return(list(beta = beta, f_hist = f_hist))
}
armijo2 <- function(lossfunc, curr_loss, beta, X, eta, g, y, eps) {
left <- lossfunc(beta- eta*g, X , y)
right <- curr_loss - eps * eta * t(g) %*% g
return (left > right)
}
# Backtracking Line Search (BLS)
gd_bls <- function(X, y, eta_init = 1.0, epsilon = 0.25, tau = 0.5,
max_iter = 5000, tol = 1e-5) {
beta <- matrix(0, nrow = ncol(X), ncol = 1)
f_hist <- numeric()
log <- numeric(0)
for (k in 1:max_iter) {
current_f <- f_lr(beta, X, y)
log <- c(log, current_f)
f_hist[k] <- current_f
g <- grad_f_lr(beta, X, y)
# To do:  Convergence Criterion:
if (norm(g, type="2")<tol) {
cat("BLS Converged in", k, "iterations.\n")
break
}
# ToDO: Armijo Condition
eta <- eta_init
while (armijo2(f_lr, current_f, beta, X, eta, g, y, epsilon)) {
eta <- tau * eta
}
beta <- beta - eta * g
}
if (k == max_iter) cat("BLS reached max iterations.\n")
# Graph
plot(log,type="l", xlab="Iteration", ylab="f(x) (loss)", main=paste("Backtracked GD"), cex.main=0.7, cex.lab = 0.5, cex.axis=0.5)
return(list(beta = beta, f_hist = f_hist))
}
